{
	"easycom": {
		"autoscan": true,
		"custom": {
			// 将 npm 安装的 uni-ui 组件按 uni-* 标签自动解析，避免每个页面重复注册。
			"^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue",
			"^protected-image$": "@/componment/ProtectedImage.vue"
		}
	},
	"pages": [ //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
		{
			"path": "pages/login/code_index",
			"style": {
				"navigationBarTitleText": "验证码登录",
				"navigationStyle": "custom"
			}
		},
		{
			// 专家使用独立双入口导航，避免显示农场主固定四栏 TabBar。
			// 消息页由内部列表滚动，原生页面不能带动顶部导航滑动。
			"path": "pages/expert/news",
			"style": { "navigationBarTitleText": "咨询消息", "navigationStyle": "custom", "disableScroll": true }
		},
		{
			"path": "pages/expert/mine",
			"style": { "navigationBarTitleText": "个人中心", "navigationStyle": "custom" }
		},
		{
			// 技术人员故障首页沿用现有页面，这两页使用独立三入口导航。
