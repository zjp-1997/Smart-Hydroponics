			"style": { "navigationBarTitleText": "消息", "navigationStyle": "custom", "disableScroll": true }
		},
		{
			"path": "pages/technician/mine",
			"style": { "navigationBarTitleText": "我的", "navigationStyle": "custom" }
		},
