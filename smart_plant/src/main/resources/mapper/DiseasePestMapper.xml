<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    病虫害基础信息 MyBatis 映射文件。
    负责 disease_pest 表的字段映射、增删改查、条件查询和名称重复统计。
-->
<mapper namespace="com.smart_plant.smart_plant.mapper.DiseasePestMapper">

    <!-- 字段映射：将数据库字段映射到 DiseasePest 实体属性。 -->
    <resultMap id="DiseasePestResultMap" type="com.smart_plant.smart_plant.entity.DiseasePest">
        <id column="id" property="id"/>
        <result column="crop_type_id" property="cropTypeId"/>
        <result column="crop_type_name" property="cropTypeName"/>
        <result column="affected_crops" property="affectedCrops"/>
        <result column="name" property="name"/>
        <result column="type" property="type"/>
        <result column="symptom" property="symptom"/>
        <result column="cause" property="cause"/>
        <result column="suitable_stage" property="suitableStage"/>
        <result column="occurrence_period" property="occurrencePeriod"/>
        <result column="living_habits" property="livingHabits"/>
        <result column="suitable_environment" property="suitableEnvironment"/>
        <result column="transmission_route" property="transmissionRoute"/>
        <result column="cover_image" property="coverImage"/>
        <!-- JSON 类型处理器让接口直接返回字符串数组，避免前端解析数据库 JSON 文本。 -->
        <result column="image_urls" property="imageUrls"
                typeHandler="com.smart_plant.smart_plant.typehandler.JsonStringListTypeHandler"/>
        <result column="status" property="status"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 通用查询列：额外关联 crop_type.type_name 作为 cropTypeName 返回给前端展示。 -->
    <sql id="BaseColumns">
        dp.id, dp.crop_type_id, ct.type_name AS crop_type_name, dp.affected_crops,
        dp.name, dp.type, dp.symptom, dp.cause, dp.suitable_stage, dp.occurrence_period,
        dp.living_habits, dp.suitable_environment, dp.transmission_route,
        dp.cover_image, dp.image_urls, dp.status, dp.sort_order,
        dp.remark, dp.create_time, dp.update_time
    </sql>

    <!-- 新增病虫害基础信息：只写入有值字段，未传字段使用数据库默认值。 -->
    <insert id="insert" parameterType="com.smart_plant.smart_plant.entity.DiseasePest"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `disease_pest`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="cropTypeId != null">crop_type_id,</if>
            <if test="affectedCrops != null and affectedCrops != ''">affected_crops,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="type != null">type,</if>
            <if test="symptom != null and symptom != ''">symptom,</if>
            <if test="cause != null and cause != ''">cause,</if>
            <if test="suitableStage != null and suitableStage != ''">suitable_stage,</if>
            <if test="occurrencePeriod != null and occurrencePeriod != ''">occurrence_period,</if>
            <if test="livingHabits != null and livingHabits != ''">living_habits,</if>
            <if test="suitableEnvironment != null and suitableEnvironment != ''">suitable_environment,</if>
            <if test="transmissionRoute != null and transmissionRoute != ''">transmission_route,</if>
            <if test="coverImage != null and coverImage != ''">cover_image,</if>
            <if test="imageUrls != null">image_urls,</if>
            <if test="status != null">status,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="remark != null and remark != ''">remark,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="cropTypeId != null">#{cropTypeId},</if>
            <if test="affectedCrops != null and affectedCrops != ''">#{affectedCrops},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="type != null">#{type},</if>
            <if test="symptom != null and symptom != ''">#{symptom},</if>
            <if test="cause != null and cause != ''">#{cause},</if>
            <if test="suitableStage != null and suitableStage != ''">#{suitableStage},</if>
            <if test="occurrencePeriod != null and occurrencePeriod != ''">#{occurrencePeriod},</if>
            <if test="livingHabits != null and livingHabits != ''">#{livingHabits},</if>
            <if test="suitableEnvironment != null and suitableEnvironment != ''">#{suitableEnvironment},</if>
            <if test="transmissionRoute != null and transmissionRoute != ''">#{transmissionRoute},</if>
            <if test="coverImage != null and coverImage != ''">#{coverImage},</if>
            <if test="imageUrls != null">#{imageUrls,typeHandler=com.smart_plant.smart_plant.typehandler.JsonStringListTypeHandler},</if>
            <if test="status != null">#{status},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>

    <!-- 根据ID物理删除病虫害基础信息，关联防治措施由外键级联处理。 -->
    <delete id="deleteById">
        DELETE FROM `disease_pest` WHERE id = #{id}
    </delete>

    <!-- 根据ID集合批量物理删除病虫害基础信息。 -->
    <delete id="deleteBatchByIds">
        DELETE FROM `disease_pest`
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 根据ID动态更新病虫害基础信息，未传字段保持原值。 -->
    <update id="updateById" parameterType="com.smart_plant.smart_plant.entity.DiseasePest">
        UPDATE `disease_pest`
        <set>
            <if test="cropTypeId != null">crop_type_id = #{cropTypeId},</if>
            <if test="affectedCrops != null">affected_crops = #{affectedCrops},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="type != null">type = #{type},</if>
            <if test="symptom != null">symptom = #{symptom},</if>
            <if test="cause != null">cause = #{cause},</if>
            <if test="suitableStage != null">suitable_stage = #{suitableStage},</if>
            <if test="occurrencePeriod != null">occurrence_period = #{occurrencePeriod},</if>
            <if test="livingHabits != null">living_habits = #{livingHabits},</if>
            <if test="suitableEnvironment != null">suitable_environment = #{suitableEnvironment},</if>
            <if test="transmissionRoute != null">transmission_route = #{transmissionRoute},</if>
            <if test="coverImage != null">cover_image = #{coverImage},</if>
            <if test="imageUrls != null">image_urls = #{imageUrls,typeHandler=com.smart_plant.smart_plant.typehandler.JsonStringListTypeHandler},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="remark != null">remark = #{remark},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 单独修改启用/停用状态。 -->
    <update id="updateStatus">
        UPDATE `disease_pest`
        SET status = #{status}
        WHERE id = #{id}
    </update>

    <!-- 根据ID查询病虫害详情，并带出作物类型名称。 -->
    <select id="selectById" resultMap="DiseasePestResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `disease_pest` dp
        LEFT JOIN `crop_type` ct ON ct.id = dp.crop_type_id
        WHERE dp.id = #{id}
    </select>

    <!-- 条件查询病虫害列表，支持名称、作物类型、类型和状态筛选。 -->
    <select id="selectList" resultMap="DiseasePestResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `disease_pest` dp
        LEFT JOIN `crop_type` ct ON ct.id = dp.crop_type_id
        <where>
            <if test="name != null and name != ''">
                AND dp.name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="cropTypeId != null">
                AND dp.crop_type_id = #{cropTypeId}
            </if>
            <if test="type != null">
                AND dp.type = #{type}
            </if>
            <if test="status != null">
                AND dp.status = #{status}
            </if>
        </where>
        ORDER BY dp.sort_order ASC, dp.id DESC
    </select>

    <!-- 统计同一作物类型下同名病虫害数量，cropTypeId 为空时统计通用病虫害名称是否重复。 -->
    <select id="countByCropTypeIdAndName" resultType="int">
        SELECT COUNT(1)
        FROM `disease_pest`
        WHERE name = #{name}
        <choose>
            <when test="cropTypeId != null">
                AND crop_type_id = #{cropTypeId}
            </when>
            <otherwise>
                AND crop_type_id IS NULL
            </otherwise>
        </choose>
        <if test="excludeId != null">
            AND id != #{excludeId}
        </if>
    </select>
</mapper>
