<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smart_plant.smart_plant.mapper.AiRecognitionRecordMapper">

    <resultMap id="AiRecognitionRecordResultMap" type="com.smart_plant.smart_plant.entity.AiRecognitionRecord">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="username" property="username"/>
        <result column="nickname" property="nickname"/>
        <result column="source_type" property="sourceType"/>
        <result column="crop_image_id" property="cropImageId"/>
        <result column="camera_id" property="cameraId"/>
        <result column="camera_name" property="cameraName"/>
        <result column="plot_id" property="plotId"/>
        <result column="plot_name" property="plotName"/>
        <result column="plot_code" property="plotCode"/>
        <result column="capture_id" property="captureId"/>
        <result column="image_url" property="imageUrl"/>
        <result column="thumbnail_url" property="thumbnailUrl"/>
        <result column="image_size" property="imageSize"/>
        <result column="status" property="status"/>
        <result column="recognition_start_time" property="recognitionStartTime"/>
        <result column="recognition_end_time" property="recognitionEndTime"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="result_id" property="resultId"/>
        <result column="recognition_type" property="recognitionType"/>
        <result column="recognition_type_name" property="recognitionTypeName"/>
        <result column="crop_id" property="cropId"/>
        <result column="crop_name" property="cropName"/>
        <result column="result_name" property="resultName"/>
        <result column="result_summary" property="resultSummary"/>
        <result column="result_detail" property="resultDetail"/>
        <result column="disease_pest_id" property="diseasePestId"/>
        <result column="disease_pest_name" property="diseasePestName"/>
        <result column="confidence" property="confidence"/>
        <result column="severity_level" property="severityLevel"/>
        <result column="suggestion" property="suggestion"/>
        <result column="model_name" property="modelName"/>
        <result column="model_version" property="modelVersion"/>
        <result column="result_status" property="resultStatus"/>
        <result column="fail_reason" property="failReason"/>
        <result column="recognize_time" property="recognizeTime"/>
        <result column="result_remark" property="resultRemark"/>
        <result column="result_create_time" property="resultCreateTime"/>
        <result column="result_count" property="resultCount"/>
    </resultMap>

    <sql id="BaseColumns">
        rr.id, rr.user_id, u.username, u.nickname,
        rr.source_type, rr.crop_image_id,
        rr.camera_id, cd.name AS camera_name,
        rr.plot_id, p.plot_name, p.plot_code,
        rr.capture_id, rr.image_url, rr.thumbnail_url, rr.image_size,
        rr.status, rr.recognition_start_time, rr.recognition_end_time,
        rr.remark, rr.create_time, rr.update_time,
        ar.id AS result_id, ar.recognition_type, art.type_name AS recognition_type_name,
        ar.crop_id, c.crop_name, ar.result_name, ar.result_summary,
        ar.result_detail, ar.disease_pest_id, dp.name AS disease_pest_name,
        ar.confidence, ar.severity_level, ar.suggestion,
        ar.model_name, ar.model_version, ar.status AS result_status,
        ar.fail_reason, ar.recognize_time, ar.remark AS result_remark,
        ar.create_time AS result_create_time,
        (
            SELECT COUNT(1)
            FROM `ai_recognition_result` arc
            WHERE arc.record_id = rr.id
        ) AS result_count
    </sql>

    <sql id="RecordJoin">
        LEFT JOIN `user` u ON u.id = rr.user_id
        LEFT JOIN `camera_device` cd ON cd.id = rr.camera_id
        LEFT JOIN `plot` p ON p.id = rr.plot_id
        LEFT JOIN `ai_recognition_result` ar ON ar.id = (
            SELECT ar2.id
            FROM `ai_recognition_result` ar2
            WHERE ar2.record_id = rr.id
            ORDER BY ar2.id DESC
            LIMIT 1
        )
        LEFT JOIN `ai_recognition_type` art ON art.id = ar.recognition_type
        LEFT JOIN `crop` c ON c.id = ar.crop_id
        LEFT JOIN `disease_pest` dp ON dp.id = ar.disease_pest_id
    </sql>

    <sql id="QueryWhere">
        <where>
            <if test="userId != null">
                AND rr.user_id = #{userId}
            </if>
            <if test="username != null and username != ''">
                AND (u.username LIKE CONCAT('%', #{username}, '%')
                    OR u.nickname LIKE CONCAT('%', #{username}, '%'))
            </if>
            <if test="sourceType != null">
                AND rr.source_type = #{sourceType}
            </if>
            <if test="status != null">
                AND rr.status = #{status}
            </if>
            <if test="resultStatus != null">
                AND ar.status = #{resultStatus}
            </if>
            <if test="cameraName != null and cameraName != ''">
                AND cd.name LIKE CONCAT('%', #{cameraName}, '%')
            </if>
            <if test="plotName != null and plotName != ''">
                AND p.plot_name LIKE CONCAT('%', #{plotName}, '%')
            </if>
            <if test="recognitionType != null">
                AND ar.recognition_type = #{recognitionType}
            </if>
            <if test="resultName != null and resultName != ''">
                AND ar.result_name LIKE CONCAT('%', #{resultName}, '%')
            </if>
            <if test="startTime != null">
                AND rr.create_time &gt;= #{startTime}
            </if>
            <if test="endTime != null">
                AND rr.create_time &lt;= #{endTime}
            </if>
        </where>
    </sql>

    <!-- 新增AI识别记录：动态列只写入当前流程明确提供的字段，避免无意义空值覆盖数据库默认值。 -->
    <insert id="insertRecord" parameterType="com.smart_plant.smart_plant.entity.AiRecognitionRecord"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `ai_recognition_record`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="sourceType != null">source_type,</if>
            <if test="cropImageId != null">crop_image_id,</if>
            <if test="cameraId != null">camera_id,</if>
            <if test="plotId != null">plot_id,</if>
            <if test="captureId != null">capture_id,</if>
            <if test="imageUrl != null and imageUrl != ''">image_url,</if>
            <if test="thumbnailUrl != null and thumbnailUrl != ''">thumbnail_url,</if>
            <if test="imageSize != null">image_size,</if>
            <if test="status != null">status,</if>
            <if test="recognitionStartTime != null">recognition_start_time,</if>
            <if test="recognitionEndTime != null">recognition_end_time,</if>
            <if test="remark != null and remark != ''">remark,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="sourceType != null">#{sourceType},</if>
            <if test="cropImageId != null">#{cropImageId},</if>
            <if test="cameraId != null">#{cameraId},</if>
            <if test="plotId != null">#{plotId},</if>
            <if test="captureId != null">#{captureId},</if>
            <if test="imageUrl != null and imageUrl != ''">#{imageUrl},</if>
            <if test="thumbnailUrl != null and thumbnailUrl != ''">#{thumbnailUrl},</if>
            <if test="imageSize != null">#{imageSize},</if>
            <if test="status != null">#{status},</if>
            <if test="recognitionStartTime != null">#{recognitionStartTime},</if>
            <if test="recognitionEndTime != null">#{recognitionEndTime},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>

    <!-- 新增AI识别结果：record_id 与 recognition_type 必填，其余字段按识别能力逐步补充。 -->
    <insert id="insertResult" parameterType="com.smart_plant.smart_plant.entity.AiRecognitionResult"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `ai_recognition_result`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="recordId != null">record_id,</if>
            <if test="cropId != null">crop_id,</if>
            <if test="recognitionType != null">recognition_type,</if>
            <if test="resultName != null and resultName != ''">result_name,</if>
            <if test="resultSummary != null and resultSummary != ''">result_summary,</if>
            <if test="resultDetail != null and resultDetail != ''">result_detail,</if>
            <if test="diseasePestId != null">disease_pest_id,</if>
            <if test="confidence != null">confidence,</if>
            <if test="severityLevel != null">severity_level,</if>
            <if test="suggestion != null and suggestion != ''">suggestion,</if>
            <if test="modelName != null and modelName != ''">model_name,</if>
            <if test="modelVersion != null and modelVersion != ''">model_version,</if>
            <if test="status != null">status,</if>
            <if test="failReason != null and failReason != ''">fail_reason,</if>
            <if test="recognizeTime != null">recognize_time,</if>
            <if test="remark != null and remark != ''">remark,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="recordId != null">#{recordId},</if>
            <if test="cropId != null">#{cropId},</if>
            <if test="recognitionType != null">#{recognitionType},</if>
            <if test="resultName != null and resultName != ''">#{resultName},</if>
            <if test="resultSummary != null and resultSummary != ''">#{resultSummary},</if>
            <if test="resultDetail != null and resultDetail != ''">#{resultDetail},</if>
            <if test="diseasePestId != null">#{diseasePestId},</if>
            <if test="confidence != null">#{confidence},</if>
            <if test="severityLevel != null">#{severityLevel},</if>
            <if test="suggestion != null and suggestion != ''">#{suggestion},</if>
            <if test="modelName != null and modelName != ''">#{modelName},</if>
            <if test="modelVersion != null and modelVersion != ''">#{modelVersion},</if>
            <if test="status != null">#{status},</if>
            <if test="failReason != null and failReason != ''">#{failReason},</if>
            <if test="recognizeTime != null">#{recognizeTime},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>

    <delete id="deleteById">
        DELETE FROM `ai_recognition_record`
        WHERE id = #{id}
    </delete>

    <delete id="deleteBatchByIds">
        DELETE FROM `ai_recognition_record`
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteResultsByRecordId">
        DELETE FROM `ai_recognition_result`
        WHERE record_id = #{recordId}
    </delete>

    <delete id="deleteResultsByRecordIds">
        DELETE FROM `ai_recognition_result`
        WHERE record_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <update id="clearChatSessionResultLinksByRecordId">
        UPDATE `ai_chat_session`
        SET recognition_result_id = NULL
        WHERE recognition_result_id IN (
            SELECT id
            FROM `ai_recognition_result`
            WHERE record_id = #{recordId}
        )
    </update>

    <update id="clearChatSessionResultLinksByRecordIds">
        UPDATE `ai_chat_session`
        SET recognition_result_id = NULL
        WHERE recognition_result_id IN (
            SELECT id
            FROM `ai_recognition_result`
            WHERE record_id IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        )
    </update>

    <select id="selectById" resultMap="AiRecognitionRecordResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `ai_recognition_record` rr
        <include refid="RecordJoin"/>
        WHERE rr.id = #{id}
    </select>

    <select id="selectList" resultMap="AiRecognitionRecordResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `ai_recognition_record` rr
        <include refid="RecordJoin"/>
        <include refid="QueryWhere"/>
        ORDER BY rr.id DESC
    </select>

    <select id="selectStatistics" resultType="map">
        SELECT
            COUNT(1) AS totalCount,
            COALESCE(SUM(CASE WHEN rr.source_type = 1 THEN 1 ELSE 0 END), 0) AS manualCount,
            COALESCE(SUM(CASE WHEN rr.source_type = 2 THEN 1 ELSE 0 END), 0) AS autoCount,
            COALESCE(SUM(CASE WHEN rr.status = 1 THEN 1 ELSE 0 END), 0) AS pendingCount,
            COALESCE(SUM(CASE WHEN rr.status = 2 THEN 1 ELSE 0 END), 0) AS runningCount,
            COALESCE(SUM(CASE WHEN rr.status = 3 THEN 1 ELSE 0 END), 0) AS completedCount,
            COALESCE(SUM(CASE WHEN rr.status = 4 THEN 1 ELSE 0 END), 0) AS failedRecordCount,
            COALESCE(SUM(CASE WHEN ar.status = 1 THEN 1 ELSE 0 END), 0) AS successResultCount,
            COALESCE(SUM(CASE WHEN ar.status = 2 THEN 1 ELSE 0 END), 0) AS failedResultCount,
            MIN(rr.create_time) AS firstCreateTime,
            MAX(rr.create_time) AS latestCreateTime
        FROM `ai_recognition_record` rr
        <include refid="RecordJoin"/>
        <include refid="QueryWhere"/>
    </select>
</mapper>
