<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smart_plant.smart_plant.mapper.DeviceTypeMapper">

    <!-- 设备类型结果映射：把 device_type 表字段转换为 Java 驼峰属性。 -->
    <resultMap id="DeviceTypeResultMap" type="com.smart_plant.smart_plant.entity.DeviceType">
        <id column="id" property="id"/>
        <result column="type_code" property="typeCode"/>
        <result column="type_name" property="typeName"/>
        <result column="category" property="category"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 设备类型基础字段片段：列表和详情查询复用，避免字段遗漏。 -->
    <sql id="BaseColumns">
        id, type_code, type_name, category, description, status, create_time, update_time
    </sql>

    <!-- 新增设备类型：使用动态列，只写入业务层校验和补齐后的字段。 -->
    <insert id="insert" parameterType="com.smart_plant.smart_plant.entity.DeviceType"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `device_type`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="typeCode != null and typeCode != ''">type_code,</if>
            <if test="typeName != null and typeName != ''">type_name,</if>
            <if test="category != null">category,</if>
            <if test="description != null and description != ''">description,</if>
            <if test="status != null">status,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="typeCode != null and typeCode != ''">#{typeCode},</if>
            <if test="typeName != null and typeName != ''">#{typeName},</if>
            <if test="category != null">#{category},</if>
            <if test="description != null and description != ''">#{description},</if>
            <if test="status != null">#{status},</if>
        </trim>
    </insert>

    <!-- 根据主键删除单条设备类型。 -->
    <delete id="deleteById">
        DELETE FROM `device_type` WHERE id = #{id}
    </delete>

    <!-- 批量删除设备类型，foreach 会把 ID 集合展开成 IN 条件。 -->
    <delete id="deleteBatchByIds">
        DELETE FROM `device_type`
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 动态修改设备类型信息：只更新非空字段，避免覆盖未提交的数据。 -->
    <update id="updateById" parameterType="com.smart_plant.smart_plant.entity.DeviceType">
        UPDATE `device_type`
        <set>
            <if test="typeCode != null and typeCode != ''">type_code = #{typeCode},</if>
            <if test="typeName != null and typeName != ''">type_name = #{typeName},</if>
            <if test="category != null">category = #{category},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 单独修改设备类型状态。 -->
    <update id="updateStatus">
        UPDATE `device_type`
        SET status = #{status}
        WHERE id = #{id}
    </update>

    <!-- 根据主键查询设备类型详情。 -->
    <select id="selectById" resultMap="DeviceTypeResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `device_type`
        WHERE id = #{id}
    </select>

    <!-- 根据唯一类型编码查询设备类型。 -->
    <select id="selectByTypeCode" resultMap="DeviceTypeResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `device_type`
        WHERE type_code = #{typeCode}
        LIMIT 1
    </select>

    <!-- 分页前置列表查询：支持按编码、名称、分类和状态筛选。 -->
    <select id="selectList" resultMap="DeviceTypeResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `device_type`
        <where>
            <if test="typeCode != null and typeCode != ''">
                AND type_code LIKE CONCAT('%', #{typeCode}, '%')
            </if>
            <if test="typeName != null and typeName != ''">
                AND type_name LIKE CONCAT('%', #{typeName}, '%')
            </if>
            <if test="category != null">
                AND category = #{category}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY id ASC
    </select>

    <!-- 统计同编码记录数量，excludeId 用于修改时排除当前记录。 -->
    <select id="countByTypeCode" resultType="int">
        SELECT COUNT(1)
        FROM `device_type`
        WHERE type_code = #{typeCode}
        <if test="excludeId != null">
            AND id != #{excludeId}
        </if>
    </select>

    <!-- 统计设备表引用数量，用于设备类型删除保护。 -->
    <select id="countDevicesByTypeId" resultType="int">
        SELECT COUNT(1)
        FROM `iot_device`
        WHERE type_id = #{typeId}
    </select>
</mapper>
