<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 水泵监测数据 MyBatis 映射文件，对应 pump_data 表。 -->
<mapper namespace="com.smart_plant.smart_plant.mapper.PumpDataMapper">

    <!-- 水泵监测数据字段和 Java 实体属性的映射关系。 -->
    <resultMap id="PumpDataResultMap" type="com.smart_plant.smart_plant.entity.PumpData">
        <id column="id" property="id"/>
        <result column="device_id" property="deviceId"/>
        <result column="message_key" property="messageKey"/>
        <result column="owner_user_id" property="ownerUserId"/>
        <result column="device_code" property="deviceCode"/>
        <result column="device_name" property="deviceName"/>
        <result column="type_id" property="typeId"/>
        <result column="type_code" property="typeCode"/>
        <result column="type_name" property="typeName"/>
        <result column="plot_id" property="plotId"/>
        <result column="plot_name" property="plotName"/>
        <result column="plot_code" property="plotCode"/>
        <result column="water_flow" property="waterFlow"/>
        <result column="water_pressure" property="waterPressure"/>
        <result column="data_status" property="dataStatus"/>
        <result column="abnormal_detail" property="abnormalDetail"/>
        <result column="cumulative_runtime" property="cumulativeRuntime"/>
        <result column="collect_time" property="collectTime"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!-- 水泵监测数据通用查询字段。 -->
    <sql id="BaseColumns">
        pd.id, pd.device_id, pd.message_key,
        COALESCE(pd.owner_user_id, d.user_id) AS owner_user_id,
        d.device_code, d.name AS device_name, d.type_id,
        dt.type_code, dt.type_name,
        COALESCE(pd.plot_id_at_collection, d.plot_id) AS plot_id, p.plot_name, p.plot_code,
        pd.water_flow, pd.water_pressure,
        pd.data_status, pd.abnormal_detail, pd.cumulative_runtime,
        pd.collect_time, pd.remark, pd.create_time
    </sql>

    <!-- 水泵数据关联设备、设备类型和地块，列表与详情查询复用。 -->
    <sql id="DataJoin">
        LEFT JOIN `iot_device` d ON d.id = pd.device_id
        LEFT JOIN `device_type` dt ON dt.id = d.type_id
        LEFT JOIN `plot` p ON p.id = COALESCE(pd.plot_id_at_collection, d.plot_id)
    </sql>

    <!-- 水泵数据公共查询条件，支持地块、设备、状态和采集时间范围筛选。 -->
    <sql id="QueryWhere">
        <where>
            <if test="userId != null">
                AND COALESCE(pd.owner_user_id, d.user_id) = #{userId}
            </if>
            <if test="plotId != null">
                AND COALESCE(pd.plot_id_at_collection, d.plot_id) = #{plotId}
            </if>
            <if test="deviceId != null">
                AND pd.device_id = #{deviceId}
            </if>
            <if test="deviceCode != null and deviceCode != ''">
                AND d.device_code LIKE CONCAT('%', #{deviceCode}, '%')
            </if>
            <if test="dataStatus != null">
                AND pd.data_status = #{dataStatus}
            </if>
            <if test="startTime != null">
                AND pd.collect_time &gt;= #{startTime}
            </if>
            <if test="endTime != null">
                AND pd.collect_time &lt;= #{endTime}
            </if>
        </where>
    </sql>

    <!-- 新增水泵监测数据。 -->
    <insert id="insert" parameterType="com.smart_plant.smart_plant.entity.PumpData"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `pump_data`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deviceId != null">device_id, owner_user_id, plot_id_at_collection,</if>
            <if test="messageKey != null and messageKey != ''">message_key,</if>
            <if test="waterFlow != null">water_flow,</if>
            <if test="waterPressure != null">water_pressure,</if>
            <if test="dataStatus != null">data_status,</if>
            <if test="abnormalDetail != null and abnormalDetail != ''">abnormal_detail,</if>
            <if test="cumulativeRuntime != null">cumulative_runtime,</if>
            <if test="collectTime != null">collect_time,</if>
            <if test="remark != null and remark != ''">remark,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="deviceId != null">
                #{deviceId},
                (SELECT user_id FROM `iot_device` WHERE id = #{deviceId}),
                (SELECT plot_id FROM `iot_device` WHERE id = #{deviceId}),
            </if>
            <if test="messageKey != null and messageKey != ''">#{messageKey},</if>
            <if test="waterFlow != null">#{waterFlow},</if>
            <if test="waterPressure != null">#{waterPressure},</if>
            <if test="dataStatus != null">#{dataStatus},</if>
            <if test="abnormalDetail != null and abnormalDetail != ''">#{abnormalDetail},</if>
            <if test="cumulativeRuntime != null">#{cumulativeRuntime},</if>
            <if test="collectTime != null">#{collectTime},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>

    <!-- 根据ID物理删除水泵监测数据。 -->
    <delete id="deleteById">
        DELETE FROM `pump_data` WHERE id = #{id}
    </delete>

    <!-- 根据ID集合批量物理删除水泵监测数据。 -->
    <delete id="deleteBatchByIds">
        DELETE FROM `pump_data`
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 根据ID动态更新水泵监测数据。 -->
    <update id="updateById" parameterType="com.smart_plant.smart_plant.entity.PumpData">
        UPDATE `pump_data`
        <set>
            <if test="deviceId != null">device_id = #{deviceId},</if>
            <if test="waterFlow != null">water_flow = #{waterFlow},</if>
            <if test="waterPressure != null">water_pressure = #{waterPressure},</if>
            <if test="dataStatus != null">data_status = #{dataStatus},</if>
            <if test="abnormalDetail != null">abnormal_detail = #{abnormalDetail},</if>
            <if test="cumulativeRuntime != null">cumulative_runtime = #{cumulativeRuntime},</if>
            <if test="collectTime != null">collect_time = #{collectTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据ID查询水泵监测数据详情。 -->
    <select id="selectById" resultMap="PumpDataResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `pump_data` pd
        <include refid="DataJoin"/>
        WHERE pd.id = #{id}
    </select>

    <!-- 分页条件查询水泵监测数据列表，支持地块、设备、数据状态和采集时间范围筛选。 -->
    <select id="selectList" resultMap="PumpDataResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `pump_data` pd
        <include refid="DataJoin"/>
        <include refid="QueryWhere"/>
        ORDER BY pd.collect_time DESC
    </select>

    <!-- 水泵监测数据统计，用于页面顶部统计卡片和趋势概览。 -->
    <select id="selectStatistics" resultType="map">
        SELECT
            COUNT(1) AS totalCount,
            COALESCE(SUM(CASE WHEN pd.data_status = 1 THEN 1 ELSE 0 END), 0) AS normalCount,
            COALESCE(SUM(CASE WHEN pd.data_status = 2 THEN 1 ELSE 0 END), 0) AS abnormalCount,
            COUNT(DISTINCT pd.device_id) AS deviceCount,
            COUNT(DISTINCT COALESCE(pd.plot_id_at_collection, d.plot_id)) AS plotCount,
            MIN(pd.collect_time) AS firstCollectTime,
            MAX(pd.collect_time) AS latestCollectTime,
            ROUND(AVG(pd.water_flow), 2) AS avgWaterFlow,
            ROUND(AVG(pd.water_pressure), 2) AS avgWaterPressure,
            ROUND(AVG(pd.cumulative_runtime), 2) AS avgCumulativeRuntime
        FROM `pump_data` pd
        <include refid="DataJoin"/>
        <include refid="QueryWhere"/>
    </select>

</mapper>
