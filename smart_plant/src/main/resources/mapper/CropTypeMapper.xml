<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 作物分类 MyBatis 映射文件，对应 crop_type 表。 -->
<mapper namespace="com.smart_plant.smart_plant.mapper.CropTypeMapper">

    <!-- 作物分类字段和 Java 实体属性的映射关系。 -->
    <resultMap id="CropTypeResultMap" type="com.smart_plant.smart_plant.entity.CropType">
        <id column="id" property="id"/>
        <result column="parent_id" property="parentId"/>
        <result column="parent_name" property="parentName"/>
        <result column="type_name" property="typeName"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 作物分类通用查询字段，父分类名称通过自连接带出。 -->
    <sql id="BaseColumns">
        ct.id, ct.parent_id, parent.type_name AS parent_name, ct.type_name,
        ct.description, ct.status, ct.create_time, ct.update_time
    </sql>

    <!-- 新增作物分类。 -->
    <insert id="insert" parameterType="com.smart_plant.smart_plant.entity.CropType"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `crop_type`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="parentId != null">parent_id,</if>
            <if test="typeName != null and typeName != ''">type_name,</if>
            <if test="description != null and description != ''">description,</if>
            <if test="status != null">status,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="parentId != null">#{parentId},</if>
            <if test="typeName != null and typeName != ''">#{typeName},</if>
            <if test="description != null and description != ''">#{description},</if>
            <if test="status != null">#{status},</if>
        </trim>
    </insert>

    <!-- 根据ID物理删除作物分类。 -->
    <delete id="deleteById">
        DELETE FROM `crop_type` WHERE id = #{id}
    </delete>

    <!-- 根据ID集合批量物理删除作物分类。 -->
    <delete id="deleteBatchByIds">
        DELETE FROM `crop_type`
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 根据ID动态更新作物分类。 -->
    <update id="updateById" parameterType="com.smart_plant.smart_plant.entity.CropType">
        UPDATE `crop_type`
        <set>
            parent_id = #{parentId},
            <if test="typeName != null and typeName != ''">type_name = #{typeName},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 单独修改作物分类启用/禁用状态。 -->
    <update id="updateStatus">
        UPDATE `crop_type`
        SET status = #{status}
        WHERE id = #{id}
    </update>

    <!-- 根据ID查询作物分类详情。 -->
    <select id="selectById" resultMap="CropTypeResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `crop_type` ct
        LEFT JOIN `crop_type` parent ON parent.id = ct.parent_id
        WHERE ct.id = #{id}
    </select>

    <!-- 分页条件查询作物分类列表。 -->
    <select id="selectList" resultMap="CropTypeResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `crop_type` ct
        LEFT JOIN `crop_type` parent ON parent.id = ct.parent_id
        <where>
            <if test="typeName != null and typeName != ''">
                AND ct.type_name LIKE CONCAT('%', #{typeName}, '%')
            </if>
            <if test="parentId != null">
                AND ct.parent_id = #{parentId}
            </if>
            <if test="status != null">
                AND ct.status = #{status}
            </if>
        </where>
        ORDER BY ct.id DESC
    </select>

    <!-- 统计同一父分类下同名分类数量，排除当前编辑记录。 -->
    <select id="countByTypeNameAndParentId" resultType="int">
        SELECT COUNT(1)
        FROM `crop_type`
        WHERE type_name = #{typeName}
        <choose>
            <when test="parentId != null">
                AND parent_id = #{parentId}
            </when>
            <otherwise>
                AND parent_id IS NULL
            </otherwise>
        </choose>
        <if test="excludeId != null">
            AND id != #{excludeId}
        </if>
    </select>

    <!-- 统计指定分类的子分类数量。 -->
    <select id="countChildrenByParentId" resultType="int">
        SELECT COUNT(1)
        FROM `crop_type`
        WHERE parent_id = #{parentId}
    </select>
</mapper>
