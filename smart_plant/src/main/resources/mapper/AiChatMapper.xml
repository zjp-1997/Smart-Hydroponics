<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smart_plant.smart_plant.mapper.AiChatMapper">

    <!-- AI对话记录字段映射：列表查询会关联用户表和模型表补充展示字段。 -->
    <resultMap id="AiChatResultMap" type="com.smart_plant.smart_plant.entity.AiChat">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="username" property="username"/>
        <result column="nickname" property="nickname"/>
        <result column="model_id" property="modelId"/>
        <result column="model_name" property="modelName"/>
        <result column="model" property="model"/>
        <result column="image_url" property="imageUrl"/>
        <result column="file_name" property="fileName"/>
        <result column="user_content" property="userContent"/>
        <result column="ai_content" property="aiContent"/>
        <result column="status" property="status"/>
        <result column="fail_reason" property="failReason"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="BaseColumns">
        c.id, c.user_id, u.username, u.nickname,
        c.model_id, m.model_name, m.model,
        c.image_url, c.file_name, c.user_content, c.ai_content,
        c.status, c.fail_reason, c.create_time, c.update_time
    </sql>

    <sql id="BaseJoin">
        LEFT JOIN `user` u ON u.id = c.user_id
        LEFT JOIN `model` m ON m.id = c.model_id
    </sql>

    <sql id="QueryWhere">
        <where>
            <if test="userId != null">
                AND c.user_id = #{userId}
            </if>
            <if test="username != null and username != ''">
                AND (u.username LIKE CONCAT('%', #{username}, '%')
                    OR u.nickname LIKE CONCAT('%', #{username}, '%'))
            </if>
            <if test="modelName != null and modelName != ''">
                AND (m.model_name LIKE CONCAT('%', #{modelName}, '%')
                    OR m.model LIKE CONCAT('%', #{modelName}, '%'))
            </if>
            <if test="status != null">
                AND c.status = #{status}
            </if>
            <if test="startTime != null">
                AND c.create_time &gt;= #{startTime}
            </if>
            <if test="endTime != null">
                AND c.create_time &lt;= #{endTime}
            </if>
        </where>
    </sql>

    <!-- 新增对话记录：用户输入、模型回复和调用状态一起落库，便于后台审计。 -->
    <insert id="insert" parameterType="com.smart_plant.smart_plant.entity.AiChat"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `ai_chat`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="modelId != null">model_id,</if>
            <if test="imageUrl != null and imageUrl != ''">image_url,</if>
            <if test="fileName != null and fileName != ''">file_name,</if>
            <if test="userContent != null and userContent != ''">user_content,</if>
            <if test="aiContent != null and aiContent != ''">ai_content,</if>
            <if test="status != null">status,</if>
            <if test="failReason != null and failReason != ''">fail_reason,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="modelId != null">#{modelId},</if>
            <if test="imageUrl != null and imageUrl != ''">#{imageUrl},</if>
            <if test="fileName != null and fileName != ''">#{fileName},</if>
            <if test="userContent != null and userContent != ''">#{userContent},</if>
            <if test="aiContent != null and aiContent != ''">#{aiContent},</if>
            <if test="status != null">#{status},</if>
            <if test="failReason != null and failReason != ''">#{failReason},</if>
        </trim>
    </insert>

    <delete id="deleteById">
        DELETE FROM `ai_chat` WHERE id = #{id}
    </delete>

    <delete id="deleteBatchByIds">
        DELETE FROM `ai_chat`
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectById" resultMap="AiChatResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `ai_chat` c
        <include refid="BaseJoin"/>
        WHERE c.id = #{id}
    </select>

    <select id="selectList" resultMap="AiChatResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `ai_chat` c
        <include refid="BaseJoin"/>
        <include refid="QueryWhere"/>
        ORDER BY c.id DESC
    </select>

    <!-- 用户端仅按当前用户ID读取成功的对话，按ID倒序取一页后由服务层恢复为聊天正序。 -->
    <select id="selectClientHistory" resultMap="AiChatResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `ai_chat` c
        <include refid="BaseJoin"/>
        WHERE c.user_id = #{userId} AND c.status = 1
        <if test="beforeId != null">
            AND c.id &lt; #{beforeId}
        </if>
        ORDER BY c.id DESC
        LIMIT #{limit}
    </select>

    <select id="selectStatistics" resultType="map">
        SELECT
            COUNT(1) AS totalCount,
            COALESCE(SUM(CASE WHEN c.status = 1 THEN 1 ELSE 0 END), 0) AS successCount,
            COALESCE(SUM(CASE WHEN c.status = 2 THEN 1 ELSE 0 END), 0) AS failedCount,
            COALESCE(SUM(CASE WHEN c.image_url IS NOT NULL AND c.image_url != '' THEN 1 ELSE 0 END), 0) AS imageCount,
            MIN(c.create_time) AS firstCreateTime,
            MAX(c.create_time) AS latestCreateTime
        FROM `ai_chat` c
        <include refid="BaseJoin"/>
        <include refid="QueryWhere"/>
    </select>
</mapper>
