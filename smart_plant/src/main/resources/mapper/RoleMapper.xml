<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smart_plant.smart_plant.mapper.RoleMapper">

    <resultMap id="RoleResultMap" type="com.smart_plant.smart_plant.entity.Role">
        <id column="id" property="id"/>
        <result column="role_name" property="roleName"/>
        <result column="role_code" property="roleCode"/>
        <result column="description" property="description"/>
        <result column="remark" property="remark"/>
        <result column="status" property="status"/>
        <result column="sort" property="sort"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <sql id="BaseColumns">
        id, role_name, role_code, description, remark, status, sort, create_by, update_by,
        create_time, update_time, is_deleted
    </sql>

    <insert id="insert" parameterType="com.smart_plant.smart_plant.entity.Role" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `role`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="roleName != null and roleName != ''">role_name,</if>
            <if test="roleCode != null and roleCode != ''">role_code,</if>
            <if test="description != null">description,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="status != null">status,</if>
            <if test="sort != null">sort,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="roleName != null and roleName != ''">#{roleName},</if>
            <if test="roleCode != null and roleCode != ''">#{roleCode},</if>
            <if test="description != null">#{description},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="status != null">#{status},</if>
            <if test="sort != null">#{sort},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
        </trim>
    </insert>

    <delete id="deleteById">
        DELETE FROM `role` WHERE id = #{id}
    </delete>

    <delete id="deleteBatchByIds">
        DELETE FROM `role`
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <update id="logicalDeleteById">
        UPDATE `role`
        SET is_deleted = 1, update_time = NOW()
        WHERE id = #{id}
    </update>

    <update id="logicalDeleteBatchByIds">
        UPDATE `role`
        SET is_deleted = 1, update_time = NOW()
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <update id="updateById" parameterType="com.smart_plant.smart_plant.entity.Role">
        UPDATE `role`
        <set>
            <if test="roleName != null and roleName != ''">role_name = #{roleName},</if>
            <if test="roleCode != null and roleCode != ''">role_code = #{roleCode},</if>
            <if test="description != null">description = #{description},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = NOW(),
        </set>
        WHERE id = #{id}
    </update>

    <select id="selectById" resultMap="RoleResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `role`
        WHERE id = #{id}
          AND is_deleted = 0
    </select>

    <select id="selectByRoleCode" resultMap="RoleResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `role`
        WHERE LOWER(role_code) = LOWER(#{roleCode})
          AND is_deleted = 0
        LIMIT 1
    </select>

    <select id="selectList" resultMap="RoleResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `role`
        <where>
            AND is_deleted = 0
            <if test="roleName != null and roleName != ''">
                AND role_name LIKE CONCAT('%', #{roleName}, '%')
            </if>
            <if test="roleCode != null and roleCode != ''">
                AND role_code LIKE CONCAT('%', #{roleCode}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY sort ASC, id DESC
    </select>

    <select id="countByRoleName" resultType="int">
        SELECT COUNT(1)
        FROM `role`
        WHERE role_name = #{roleName}
          AND is_deleted = 0
        <if test="excludeId != null">
            AND id != #{excludeId}
        </if>
    </select>

    <select id="countByRoleCode" resultType="int">
        SELECT COUNT(1)
        FROM `role`
        WHERE role_code = #{roleCode}
          AND is_deleted = 0
        <if test="excludeId != null">
            AND id != #{excludeId}
        </if>
    </select>
</mapper>
