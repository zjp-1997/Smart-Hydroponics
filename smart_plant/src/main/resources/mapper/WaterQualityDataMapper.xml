<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 水质监测数据 MyBatis 映射文件，对应 water_quality_data 表。 -->
<mapper namespace="com.smart_plant.smart_plant.mapper.WaterQualityDataMapper">

    <!-- 水质监测数据字段和 Java 实体属性的映射关系。 -->
    <resultMap id="WaterQualityDataResultMap" type="com.smart_plant.smart_plant.entity.WaterQualityData">
        <id column="id" property="id"/>
        <result column="device_id" property="deviceId"/>
        <result column="message_key" property="messageKey"/>
        <result column="owner_user_id" property="ownerUserId"/>
        <result column="device_code" property="deviceCode"/>
        <result column="device_name" property="deviceName"/>
        <result column="type_id" property="typeId"/>
        <result column="type_code" property="typeCode"/>
        <result column="type_name" property="typeName"/>
        <result column="plot_id" property="plotId"/>
        <result column="plot_name" property="plotName"/>
        <result column="plot_code" property="plotCode"/>
        <result column="water_temperature" property="waterTemperature"/>
        <result column="ph" property="ph"/>
        <result column="ec_value" property="ecValue"/>
        <result column="dissolved_oxygen" property="dissolvedOxygen"/>
        <result column="data_status" property="dataStatus"/>
        <result column="abnormal_detail" property="abnormalDetail"/>
        <result column="cumulative_runtime" property="cumulativeRuntime"/>
        <result column="collect_time" property="collectTime"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!-- 水质监测数据通用查询字段。 -->
    <sql id="BaseColumns">
        wq.id, wq.device_id, wq.message_key,
        COALESCE(wq.owner_user_id, d.user_id) AS owner_user_id,
        d.device_code, d.name AS device_name, d.type_id,
        dt.type_code, dt.type_name,
        COALESCE(wq.plot_id_at_collection, d.plot_id) AS plot_id, p.plot_name, p.plot_code,
        wq.water_temperature, wq.ph,
        wq.ec_value, wq.dissolved_oxygen, wq.data_status, wq.abnormal_detail,
        wq.cumulative_runtime, wq.collect_time, wq.remark, wq.create_time
    </sql>

    <!-- 水质数据关联设备、设备类型和地块，列表与详情查询复用。 -->
    <sql id="DataJoin">
        LEFT JOIN `iot_device` d ON d.id = wq.device_id
        LEFT JOIN `device_type` dt ON dt.id = d.type_id
        LEFT JOIN `plot` p ON p.id = COALESCE(wq.plot_id_at_collection, d.plot_id)
    </sql>

    <!-- 水质数据公共查询条件，支持地块、设备、状态和采集时间范围筛选。 -->
    <sql id="QueryWhere">
        <where>
            <if test="userId != null">
                AND COALESCE(wq.owner_user_id, d.user_id) = #{userId}
            </if>
            <if test="plotId != null">
                AND COALESCE(wq.plot_id_at_collection, d.plot_id) = #{plotId}
            </if>
            <if test="deviceId != null">
                AND wq.device_id = #{deviceId}
            </if>
            <if test="deviceCode != null and deviceCode != ''">
                AND d.device_code LIKE CONCAT('%', #{deviceCode}, '%')
            </if>
            <if test="dataStatus != null">
                AND wq.data_status = #{dataStatus}
            </if>
            <if test="startTime != null">
                AND wq.collect_time &gt;= #{startTime}
            </if>
            <if test="endTime != null">
                AND wq.collect_time &lt;= #{endTime}
            </if>
        </where>
    </sql>

    <!-- 新增水质监测数据。 -->
    <insert id="insert" parameterType="com.smart_plant.smart_plant.entity.WaterQualityData"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `water_quality_data`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deviceId != null">device_id, owner_user_id, plot_id_at_collection,</if>
            <if test="messageKey != null and messageKey != ''">message_key,</if>
            <if test="waterTemperature != null">water_temperature,</if>
            <if test="ph != null">ph,</if>
            <if test="ecValue != null">ec_value,</if>
            <if test="dissolvedOxygen != null">dissolved_oxygen,</if>
            <if test="dataStatus != null">data_status,</if>
            <if test="abnormalDetail != null and abnormalDetail != ''">abnormal_detail,</if>
            <if test="cumulativeRuntime != null">cumulative_runtime,</if>
            <if test="collectTime != null">collect_time,</if>
            <if test="remark != null and remark != ''">remark,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="deviceId != null">
                #{deviceId},
                (SELECT user_id FROM `iot_device` WHERE id = #{deviceId}),
                (SELECT plot_id FROM `iot_device` WHERE id = #{deviceId}),
            </if>
            <if test="messageKey != null and messageKey != ''">#{messageKey},</if>
            <if test="waterTemperature != null">#{waterTemperature},</if>
            <if test="ph != null">#{ph},</if>
            <if test="ecValue != null">#{ecValue},</if>
            <if test="dissolvedOxygen != null">#{dissolvedOxygen},</if>
            <if test="dataStatus != null">#{dataStatus},</if>
            <if test="abnormalDetail != null and abnormalDetail != ''">#{abnormalDetail},</if>
            <if test="cumulativeRuntime != null">#{cumulativeRuntime},</if>
            <if test="collectTime != null">#{collectTime},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>

    <!-- 根据ID物理删除水质监测数据。 -->
    <delete id="deleteById">
        DELETE FROM `water_quality_data` WHERE id = #{id}
    </delete>

    <!-- 根据ID集合批量物理删除水质监测数据。 -->
    <delete id="deleteBatchByIds">
        DELETE FROM `water_quality_data`
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 根据ID动态更新水质监测数据。 -->
    <update id="updateById" parameterType="com.smart_plant.smart_plant.entity.WaterQualityData">
        UPDATE `water_quality_data`
        <set>
            <if test="deviceId != null">device_id = #{deviceId},</if>
            <if test="waterTemperature != null">water_temperature = #{waterTemperature},</if>
            <if test="ph != null">ph = #{ph},</if>
            <if test="ecValue != null">ec_value = #{ecValue},</if>
            <if test="dissolvedOxygen != null">dissolved_oxygen = #{dissolvedOxygen},</if>
            <if test="dataStatus != null">data_status = #{dataStatus},</if>
            <if test="abnormalDetail != null">abnormal_detail = #{abnormalDetail},</if>
            <if test="cumulativeRuntime != null">cumulative_runtime = #{cumulativeRuntime},</if>
            <if test="collectTime != null">collect_time = #{collectTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据ID查询水质监测数据详情。 -->
    <select id="selectById" resultMap="WaterQualityDataResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `water_quality_data` wq
        <include refid="DataJoin"/>
        WHERE wq.id = #{id}
    </select>

    <!-- 分页条件查询水质监测数据列表，支持地块、设备、数据状态和采集时间范围筛选。 -->
    <select id="selectList" resultMap="WaterQualityDataResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `water_quality_data` wq
        <include refid="DataJoin"/>
        <include refid="QueryWhere"/>
        ORDER BY wq.collect_time DESC
    </select>

    <!-- 水质监测数据统计，用于页面顶部统计卡片和趋势概览。 -->
    <select id="selectStatistics" resultType="map">
        SELECT
            COUNT(1) AS totalCount,
            COALESCE(SUM(CASE WHEN wq.data_status = 1 THEN 1 ELSE 0 END), 0) AS normalCount,
            COALESCE(SUM(CASE WHEN wq.data_status = 2 THEN 1 ELSE 0 END), 0) AS abnormalCount,
            COUNT(DISTINCT wq.device_id) AS deviceCount,
            COUNT(DISTINCT COALESCE(wq.plot_id_at_collection, d.plot_id)) AS plotCount,
            MIN(wq.collect_time) AS firstCollectTime,
            MAX(wq.collect_time) AS latestCollectTime,
            ROUND(AVG(wq.water_temperature), 2) AS avgWaterTemperature,
            ROUND(AVG(wq.ph), 2) AS avgPh,
            ROUND(AVG(wq.ec_value), 2) AS avgEcValue,
            ROUND(AVG(wq.dissolved_oxygen), 2) AS avgDissolvedOxygen,
            ROUND(AVG(wq.cumulative_runtime), 2) AS avgCumulativeRuntime
        FROM `water_quality_data` wq
        <include refid="DataJoin"/>
        <include refid="QueryWhere"/>
    </select>

</mapper>
