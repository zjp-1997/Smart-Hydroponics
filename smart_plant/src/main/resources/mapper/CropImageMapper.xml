<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smart_plant.smart_plant.mapper.CropImageMapper">

    <resultMap id="CropImageResultMap" type="com.smart_plant.smart_plant.entity.CropImage">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="username" property="username"/>
        <result column="nickname" property="nickname"/>
        <result column="image_url" property="imageUrl"/>
        <result column="image_size" property="imageSize"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="BaseColumns">
        ci.id, ci.user_id, u.username, u.nickname,
        ci.image_url, ci.image_size,
        ci.remark,
        ci.create_time, ci.update_time
    </sql>

    <sql id="UserJoin">
        LEFT JOIN `user` u ON u.id = ci.user_id
    </sql>

    <insert id="insert" parameterType="com.smart_plant.smart_plant.entity.CropImage"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `crop_image`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="imageUrl != null and imageUrl != ''">image_url,</if>
            <if test="imageSize != null">image_size,</if>
            <if test="remark != null and remark != ''">remark,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="imageUrl != null and imageUrl != ''">#{imageUrl},</if>
            <if test="imageSize != null">#{imageSize},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>

    <delete id="deleteById">
        DELETE FROM `crop_image` WHERE id = #{id}
    </delete>

    <delete id="deleteBatchByIds">
        DELETE FROM `crop_image`
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <update id="updateById" parameterType="com.smart_plant.smart_plant.entity.CropImage">
        UPDATE `crop_image`
        <set>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="imageUrl != null and imageUrl != ''">image_url = #{imageUrl},</if>
            <if test="imageSize != null">image_size = #{imageSize},</if>
            <if test="remark != null">remark = #{remark},</if>
        </set>
        WHERE id = #{id}
    </update>

    <select id="selectById" resultMap="CropImageResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `crop_image` ci
        <include refid="UserJoin"/>
        WHERE ci.id = #{id}
    </select>

    <select id="selectList" resultMap="CropImageResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `crop_image` ci
        <include refid="UserJoin"/>
        <where>
            <if test="userId != null">
                AND ci.user_id = #{userId}
            </if>
            <if test="startTime != null">
                AND ci.create_time &gt;= #{startTime}
            </if>
            <if test="endTime != null">
                AND ci.create_time &lt;= #{endTime}
            </if>
        </where>
        ORDER BY ci.id DESC
    </select>
</mapper>
