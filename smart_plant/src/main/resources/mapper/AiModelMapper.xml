<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smart_plant.smart_plant.mapper.AiModelMapper">

    <!-- AI模型配置字段映射：把 model 表下划线字段转换为 Java 驼峰属性。 -->
    <resultMap id="AiModelResultMap" type="com.smart_plant.smart_plant.entity.AiModel">
        <id column="id" property="id"/>
        <result column="model_name" property="modelName"/>
        <result column="base_url" property="baseUrl"/>
        <result column="api_key" property="apiKey"/>
        <result column="model" property="model"/>
        <result column="status" property="status"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="chat_count" property="chatCount"/>
    </resultMap>

    <sql id="BaseColumns">
        m.id, m.model_name, m.base_url, m.api_key, m.model, m.status, m.remark,
        m.create_time, m.update_time,
        (
            SELECT COUNT(1)
            FROM `ai_chat` c
            WHERE c.model_id = m.id
        ) AS chat_count
    </sql>

    <sql id="QueryWhere">
        <where>
            <if test="modelName != null and modelName != ''">
                AND m.model_name LIKE CONCAT('%', #{modelName}, '%')
            </if>
            <if test="model != null and model != ''">
                AND m.model LIKE CONCAT('%', #{model}, '%')
            </if>
            <if test="status != null">
                AND m.status = #{status}
            </if>
        </where>
    </sql>

    <!-- 新增模型配置：API Key 由后端保存，列表返回前由服务层脱敏。 -->
    <insert id="insert" parameterType="com.smart_plant.smart_plant.entity.AiModel"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `model`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="modelName != null and modelName != ''">model_name,</if>
            <if test="baseUrl != null and baseUrl != ''">base_url,</if>
            <if test="apiKey != null and apiKey != ''">api_key,</if>
            <if test="model != null and model != ''">model,</if>
            <if test="status != null">status,</if>
            <if test="remark != null and remark != ''">remark,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="modelName != null and modelName != ''">#{modelName},</if>
            <if test="baseUrl != null and baseUrl != ''">#{baseUrl},</if>
            <if test="apiKey != null and apiKey != ''">#{apiKey},</if>
            <if test="model != null and model != ''">#{model},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>

    <!-- 动态更新模型配置：apiKey 为空时不会覆盖旧密钥。 -->
    <update id="updateById" parameterType="com.smart_plant.smart_plant.entity.AiModel">
        UPDATE `model`
        <set>
            <if test="modelName != null and modelName != ''">model_name = #{modelName},</if>
            <if test="baseUrl != null and baseUrl != ''">base_url = #{baseUrl},</if>
            <if test="apiKey != null and apiKey != ''">api_key = #{apiKey},</if>
            <if test="model != null and model != ''">model = #{model},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM `model` WHERE id = #{id}
    </delete>

    <delete id="deleteBatchByIds">
        DELETE FROM `model`
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectById" resultMap="AiModelResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `model` m
        WHERE m.id = #{id}
    </select>

    <select id="selectFirstEnabled" resultMap="AiModelResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `model` m
        WHERE m.status = 1
        ORDER BY m.id ASC
        LIMIT 1
    </select>

    <!-- farm AI 咨询始终使用已配置的 DeepSeek 凭据，图片调用时可切换到 flash 视觉模型。 -->
    <select id="selectFirstEnabledDeepSeek" resultMap="AiModelResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `model` m
        WHERE m.status = 1 AND LOWER(m.model) LIKE 'deepseek-%'
        ORDER BY m.id ASC
        LIMIT 1
    </select>

    <select id="selectList" resultMap="AiModelResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM `model` m
        <include refid="QueryWhere"/>
        ORDER BY m.id DESC
    </select>

    <select id="countByModelName" resultType="int">
        SELECT COUNT(1)
        FROM `model`
        WHERE model_name = #{modelName}
        <if test="excludeId != null">
            AND id != #{excludeId}
        </if>
    </select>

    <select id="countChatsByModelId" resultType="int">
        SELECT COUNT(1)
        FROM `ai_chat`
        WHERE model_id = #{modelId}
    </select>

    <select id="selectStatistics" resultType="map">
        SELECT
            COUNT(1) AS totalCount,
            COALESCE(SUM(CASE WHEN m.status = 1 THEN 1 ELSE 0 END), 0) AS enabledCount,
            COALESCE(SUM(CASE WHEN m.status = 0 THEN 1 ELSE 0 END), 0) AS disabledCount,
            COALESCE(SUM((
                SELECT COUNT(1)
                FROM `ai_chat` c
                WHERE c.model_id = m.id
            )), 0) AS chatCount,
            MIN(m.create_time) AS firstCreateTime,
            MAX(m.create_time) AS latestCreateTime
        FROM `model` m
        <include refid="QueryWhere"/>
    </select>
</mapper>
