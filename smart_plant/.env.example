# Copy to .env for local development only. Never commit real values.
DB_URL=jdbc:mysql://127.0.0.1:3306/smart_plant?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=your_local_database_user
DB_PASSWORD=your_local_database_password
# 生产环境应单独提供仅具 DML 权限的 DB_RUNTIME_USERNAME/DB_RUNTIME_PASSWORD，
# 迁移作业使用 DB_MIGRATION_USERNAME/DB_MIGRATION_PASSWORD；本地可省略并复用上方账号。

JWT_SECRET=replace-with-at-least-32-bytes-of-high-entropy-random-data
REQUIRE_HTTPS=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_local_redis_password
REDIS_DATABASE=0

# Local development without Redis only. Production must use redis and enable its health check.
SECURITY_STATE_PROVIDER=memory
REDIS_HEALTH_ENABLED=false
spring.profiles.active=local

# Only set true once when adopting a historical non-empty database.
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_ENABLED=true
